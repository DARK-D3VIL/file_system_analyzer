<% if controller.controller_name != 'session' %>
  <nav class="navbar navbar-expand-lg navbar-light bg-light shadow-sm">
    <div class="container-fluid">
      <a class="navbar-brand fw-bold" href="#">📁 FileSystemAnalyzer</a>
      <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarContent">
        <span class="navbar-toggler-icon"></span>
      </button>
      <div class="collapse navbar-collapse justify-content-end" id="navbarContent">
        <ul class="navbar-nav">
          <li class="nav-item">
            <%= link_to 'Dashboard', dashboard_path, class: "nav-link #{'active fw-bold text-primary' if controller_name == 'dashboard'}" %>
          </li>
          <li class="nav-item">
            <%= link_to 'Files', files_path, class: "nav-link #{'active fw-bold text-primary' if controller_name == 'files'}" %>
          </li>
          <li class="nav-item">
            <%= button_to 'Sign Out', logout_path, method: :delete,
                data: { confirm: 'Are you sure you want to log out?' },
                class: 'btn btn-outline-danger ms-3' %>
          </li>
        </ul>
      </div>
    </div>
  </nav>
<% end %>
