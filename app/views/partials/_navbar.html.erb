<% if controller.controller_name != 'session' %>
  <nav class="navbar navbar-expand-lg navbar-light bg-light shadow-sm">
    <div class="container-fluid">
      <a class="navbar-brand fw-bold" href="#">📁 FileSystemAnalyzer</a>

      <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarContent">
        <span class="navbar-toggler-icon"></span>
      </button>

      <div class="collapse navbar-collapse justify-content-between" id="navbarContent">
        <ul class="navbar-nav">
          <li class="nav-item">
            <%= link_to 'Dashboard', dashboard_path,
                class: "nav-link px-3 #{'fw-bold border-bottom border-primary' if controller_name == 'dashboard'}" %>
          </li>
          <li class="nav-item">
            <%= link_to 'Files', files_path,
                class: "nav-link px-3 #{'fw-bold border-bottom border-primary' if controller_name == 'files'}" %>
          </li>
          <li class="nav-item">
            <%= link_to 'Overview', overview_path,
                class: "nav-link px-3 #{'fw-bold border-bottom border-primary' if controller_name == 'overview'}" %>
          </li>
        </ul>

        <ul class="navbar-nav ms-auto align-items-center">
          <% if controller_name == 'overview' %>
            <li class="nav-item me-2">
              <%= form_with url: request.path, method: :get, local: true, class: "d-flex" do %>
                <%= text_field_tag :search, params[:search], placeholder: "Search files...", class: "form-control me-2" %>
                <%= submit_tag "Search", class: "btn btn-outline-primary" %>
              <% end %>
            </li>
          <% end %>
          <li class="nav-item">
            <%= button_to 'Sign Out', logout_path, method: :delete,
                data: { confirm: 'Are you sure you want to log out?' },
                class: 'btn btn-outline-danger' %>
          </li>
        </ul>
      </div>
    </div>
  </nav>
<% end %>
