<div class="container mt-4">
  <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap">
    <h3 class="mb-0 me-3">
      <i class="bi bi-folder2-open"></i>
      Current Path: <span class="text-muted"><%= @current_path %></span>
    </h3>

    <%= form_with url: select_folder_path, method: :post, class: "d-inline" do %>
      <%= hidden_field_tag :path, @current_path %>
      <%= submit_tag "✅ Select this Folder", class: "btn btn-success" %>
    <% end %>
  </div>

  <% if @current_path != '.' %>
    <% parent_path = File.dirname(@current_path) %>
    <%= button_to "⬅️ Back to Parent Folder", browse_path, method: :get, params: { path: parent_path },
                  class: "btn btn-outline-secondary mb-3" %>
  <% end %>

  <div class="card shadow-sm">
    <div class="card-header bg-light fw-bold">
      <i class="bi bi-folder-symlink"></i> Folders
    </div>
    <ul class="list-group list-group-flush">
      <% @entries.each do |entry| %>
        <li class="list-group-item d-flex justify-content-between align-items-center">
          <%= button_to browse_path, method: :get,
                        params: { path: File.join(@current_path, entry.name).gsub(/\/$/, '/') },
                        class: "btn btn-link text-start text-decoration-none" do %>
            <i class="bi bi-folder me-2 text-warning"></i>
            <%= entry.name %>
          <% end %>
        </li>
      <% end %>
    </ul>
  </div>
</div>
